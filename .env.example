# Frontend / all runtime origins: set these in Deno Deploy's environment settings.
WISP_URL=wss://YOUR-OWN-RELAY-DOMAIN/wisp/
PUBLIC_APP_ORIGIN=https://YOUR-APP-DOMAIN
# Five distinct HTTPS origins. All may be custom domains on the same Deno app.
RUNTIME_ORIGINS={"sj-1.1.0":"https://YOUR-STABLE-DOMAIN","sj-2.0.0-alpha":"https://YOUR-ALPHA0-DOMAIN","sj-2.0.2-alpha":"https://YOUR-ALPHA2-DOMAIN","sj-2.0.67-alpha.2":"https://YOUR-ALPHA67-DOMAIN","uv-3.2.10":"https://YOUR-UV-DOMAIN"}
# Relay host only. Comma-separated app/runtime origins; never put secrets here.
ALLOWED_ORIGINS=https://YOUR-APP-DOMAIN,https://YOUR-STABLE-DOMAIN,https://YOUR-ALPHA0-DOMAIN,https://YOUR-ALPHA2-DOMAIN,https://YOUR-ALPHA67-DOMAIN,https://YOUR-UV-DOMAIN
